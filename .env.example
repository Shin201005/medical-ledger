# Generate real local secrets using scripts/init.mjs. Never commit .env.
COMPOSE_PROJECT_NAME=medical-ledger
POSTGRES_USER=medical
POSTGRES_DB=medical
POSTGRES_PASSWORD=GENERATE_ME
DATABASE_URL=postgres://medical:GENERATE_ME@localhost:5432/medical
JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEYS={"v1":"REPLACE_WITH_64_HEX_CHARACTERS"}
ACTIVE_KEY_ID=v1
AI_SERVICE_TOKEN=GENERATE_ME
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PORT=3000
IPFS_API=http://localhost:5001
STORAGE_PROVIDER=local
# PINATA_JWT=
REDIS_URL=redis://localhost:6379
CASSANDRA_HOST=localhost
AI_URL=http://localhost:8000
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_HTTPS_RPC
RPC_URL=
CHAIN_ID=11155111
CHAIN_CONFIRMATIONS=2
# Leave empty for local deployment.json lookup.
CONTRACT_ADDRESS=
# Private deployer key goes ONLY in .env.sepolia-deploy, never here.
ADMIN_EMAIL=
ADMIN_NAME=Quan tri Sepolia
ADMIN_WALLET=
ADMIN_PASSWORD=
DEMO_MODE=false
DEMO_PASSWORD=GENERATE_ME
# Standard Hardhat local mnemonic is PUBLIC and MUST NEVER be used on live networks.
# DEMO_MNEMONIC=
OCR_ALLOW_DOWNLOAD=false

# Automatic eKYC is opt-in; requires matching ID, full name, birth date and face.
# Keep false until OCR/face performance is validated with an appropriate dataset.
EKYC_AUTO_APPROVE=false
